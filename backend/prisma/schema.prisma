generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  staff
  admin
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum Status {
  Reported
  Under_Review
  Assigned
  In_Progress
  Resolved
  Rejected
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  reportedComplaints Complaint[]        @relation("ReportedBy")
  assignedComplaints Complaint[]        @relation("AssignedTo")
  historyEntries     ComplaintHistory[]
  notifications      Notification[]
  resolutions        Resolution[]

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  complaints Complaint[]

  @@map("categories")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  complaints Complaint[]

  @@map("locations")
}

model Complaint {
  id            Int       @id @default(autoincrement())
  complaintCode String    @unique @map("complaint_code")
  title         String
  description   String
  categoryId    Int       @map("category_id")
  locationId    Int       @map("location_id")
  priority      Priority
  status        Status    @default(Reported)
  reportedBy    Int       @map("reported_by")
  assignedTo    Int?      @map("assigned_to")
  imageUrl      String?   @map("image_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  resolvedAt    DateTime? @map("resolved_at")

  category Category @relation(fields: [categoryId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  reporter User      @relation("ReportedBy", fields: [reportedBy], references: [id])
  assignee User?     @relation("AssignedTo", fields: [assignedTo], references: [id])

  history       ComplaintHistory[]
  notifications Notification[]
  resolution    Resolution?

  @@index([status])
  @@index([reportedBy])
  @@index([assignedTo])
  @@index([categoryId])
  @@index([locationId])
  @@map("complaints")
}

model ComplaintHistory {
  id          Int      @id @default(autoincrement())
  complaintId Int      @map("complaint_id")
  status      Status
  changedBy   Int      @map("changed_by")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [changedBy], references: [id])

  @@map("complaint_history")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  complaintId Int      @map("complaint_id")
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Resolution {
  id          Int      @id @default(autoincrement())
  complaintId Int      @unique @map("complaint_id")
  resolvedBy  Int      @map("resolved_by")
  notes       String?
  imageUrl    String?  @map("image_url")
  resolvedAt  DateTime @default(now()) @map("resolved_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  resolver  User      @relation(fields: [resolvedBy], references: [id])

  @@map("resolution")
}

